        "expectText": "商品名称"
      },
      {
        "afterStep": 0,
        "expectText": "客户昵称"
      },
      {
        "afterStep": 0,
        "expectText": "外币采购原价"
      },
      {
        "afterStep": 0,
        "expectText": "国际运费"
      },
      {
        "afterStep": 0,
        "expectText": "国内报价"
      },
      {
        "afterStep": 0,
        "expectText": "订单状态"
      },
      {
        "afterStep": 1,
        "expectText": "日本限定保温杯"
      },
      {
        "afterStep": 1,
        "expectText": "125.20"
      },
      {
        "afterStep": 1,
        "expectText": "83.5%"
      },
      {
        "afterStep": 2,
        "expectText": "日本限定保温杯"
      }
    ]
