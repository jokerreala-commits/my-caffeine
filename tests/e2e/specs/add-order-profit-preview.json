{
  "version": 1,
  "spec": {
    "id": "add-order-profit-preview",
    "kind": "interactive",
    "goal": "新增订单表单按当前汇率实时显示人民币成本、单笔净利润与利润率，保存后列表与概览同步更新",
    "requirementIndexes": [
      7,
      8,
      9,
